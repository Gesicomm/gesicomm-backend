# ============================================================
# GESICOMM BACKEND — Variables de Entorno (Ejemplo)
# ============================================================
# Copia este archivo como .env y completa los valores reales.
# ⚠️ El archivo .env real NUNCA debe subirse a GitHub.

# --- Servidor ---
PORT=3000
NODE_ENV=production

# --- Base de Datos ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gesicomm
DB_USER=gesicomm_user
DB_PASSWORD=

# --- JWT ---
# Generar con: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRATION=7d

# --- Frontend (CORS) ---
FRONTEND_URL=https://gesicomm.com

# --- Meta CAPI ---
# El Access Token de Meta SOLO va en backend. NUNCA en el frontend.
META_ACCESS_TOKEN=
META_PIXEL_ID=
