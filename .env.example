# ============================================================
# GESICOMM BACKEND — Variables de Entorno (Ejemplo)
# ============================================================
# Copia este archivo como .env y completa los valores reales.
# ⚠️ El archivo .env real NUNCA debe subirse a GitHub.

# --- Servidor ---
PORT=3000
NODE_ENV=production

# --- Base de Datos ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gesicomm
DB_USER=gesicomm_user
DB_PASSWORD=

# --- Redis (BullMQ — recordatorios de seguimiento de pedidos) ---
# Usado por server.js (para encolar) y por el proceso worker aparte
# (npm run worker:seguimiento — ver src/workers/seguimientoWorker.js).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
# Generar con: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRATION=7d
# Secreto compartido SOLO con gesicomm-automation-hub, para /api/auth/service-token
# (mismo valor debe estar en el .env de gesicomm-automation-hub)
SERVICE_JWT_SECRET=

# --- Frontend (CORS) ---
FRONTEND_URL=https://gesicomm.com

# --- Meta OAuth ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/meta/callback
FACEBOOK_API_VERSION=v23.0
# Llave para cifrar los tokens (Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=your_32_byte_hex_key_here

# --- Dominios propios de clientes ---
# IP publica del VPS. Es la unica pieza de configuracion que necesita la
# funcion: es el valor que se le pide al cliente en su registro A, y contra
# la que se verifica su DNS (src/utils/dominios.js). El certificado lo emite
# Caddy solo, sin credenciales de ningun proveedor.
#
# Cambiarla rompe TODOS los dominios propios ya conectados hasta que cada
# cliente actualice su DNS: tratarla como un compromiso permanente.
ORIGIN_IP=155.117.43.52

# --- Brevo (emails transaccionales) ---
# EMAIL_PROVIDER puede ser brevo o smtp. Si no se define, el backend usa brevo
# cuando BREVO_API_KEY existe, o smtp cuando SMTP_USER/SMTP_PASS existen.
EMAIL_PROVIDER=brevo
# La API key real va solo en .env, nunca en frontend ni GitHub.
BREVO_API_KEY=
BREVO_FROM_EMAIL=contacto@gesicomm.com
BREVO_FROM_NAME=Gesicomm
BREVO_ADMIN_EMAIL=contacto@gesicomm.com
# Fallback si todavía no se cargó desde /admin/parametros.
ABASTECIMIENTO_NOTIFICACION_EMAIL=operaciones@gesicomm.com
