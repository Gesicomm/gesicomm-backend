# Production: a dedicated R2 bucket WITHOUT r2.dev or public/custom domains.
# Uses the existing private server-side R2 credentials. Never use R2_BUCKET_NAME.
RAHA_PRIVATE_BUCKET=
# Development only: private local directory, never exposed by express.static.
# Production local fallback is disabled. Back up the DB and private bucket together.
RAHA_PRIVATE_STORAGE_PATH=
