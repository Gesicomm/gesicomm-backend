# Add these variables to the private backend environment. Never use VITE_*.
SPEEDBOX_ENABLED=false
SPEEDBOX_ENVIRONMENT=sandbox
SPEEDBOX_API_URL=https://speedboxpy.com/api/speedbox_sandbox.php
SPEEDBOX_API_KEY=
SPEEDBOX_API_SECRET=
# Generate a random token of at least 32 characters; configure the full URL
# /api/webhooks/speedbox?environment=sandbox&token=<private-token> in the portal.
SPEEDBOX_WEBHOOK_TOKEN=
