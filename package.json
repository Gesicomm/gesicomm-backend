{
  "name": "gesicomm-backend",
  "version": "1.0.0",
  "description": "Backend seguro para Gesicomm",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "worker:seguimiento": "node src/workers/seguimientoWorker.js",
    "worker:seguimiento:dev": "nodemon src/workers/seguimientoWorker.js",
    "seed": "node scripts/seed-permissions.js",
    "create-admin": "node scripts/create-admin.js",
    "verify:pricing-parity": "node scripts/verify-pricing-parity.js",
    "test": "jest src/tests --runInBand --detectOpenHandles",
    "test:integration": "jest --config test-integration/jest.config.js --runInBand --detectOpenHandles",
    "test:speedbox:e2e": "node test-speedbox/run.cjs",
    "preview:speedbox": "node test-speedbox/run.cjs --preview"
  },
  "dependencies": {
    "archiver": "^5.3.2",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@getbrevo/brevo": "^6.0.3",
    "ajv": "^8.20.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.4",
    "pdfkit": "^0.20.2",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "sanitize-html": "2.13.1",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.3",
    "slugify": "^1.6.9",
    "whois-json": "^2.0.4",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "googlethis": "^1.8.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.0",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2"
  }
}
